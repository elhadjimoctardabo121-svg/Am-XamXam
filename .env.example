# Copier vers .env.local (jamais commité). Ces valeurs viennent de Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique (« publishable » ou « anon »). Jamais la clé service_role dans le frontend.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL publique du site, utilisée dans les liens des e-mails (en local : http://localhost:3000).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nom de marque affiché dans l'application.
NEXT_PUBLIC_APP_NAME=Am-XamXAm
